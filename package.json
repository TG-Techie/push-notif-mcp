{
  "name": "push-notification-mcp",
  "version": "0.1.0",
  "description": "MCP server that sends push notifications to the user",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "push-notification-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --target=node18",
    "bundle:mcpb": "pnpm build && rm -f push-notif-mcp.mcpb && zip -r push-notif-mcp.mcpb dist/ manifest.json package.json README.md LICENSE",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
